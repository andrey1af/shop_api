# Формат журнала без query-строки: SSE-клиент передаёт access-токен
# в ?access_token=, и он не должен попадать в журнал.
log_format sse '$remote_addr - [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

server {
    listen      80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    charset      utf-8;
    charset_types text/css application/javascript;

    client_max_body_size 20m;

    resolver         127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};

    # Server-Sent Events: ответ отдаётся клиенту сразу, без буферизации,
    # соединение живёт долго (сервер шлёт пинг каждые 15 с).
    location /api/v1/sse/ {
        proxy_pass         http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   Connection        "";
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
        access_log         /var/log/nginx/access.log sse;
        # Журнал ошибок пишет полную строку запроса вместе с токеном, а формат
        # у него не настраивается. Ошибки соединения с api (уровень error)
        # для потока не пишем: клиент сам переподключается, а доступность
        # api видна в Prometheus.
        error_log          /var/log/nginx/error.log crit;
    }

    location /api/v1/ {
        proxy_pass         http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_request_buffering off;
    }

    location /health/ {
        proxy_pass         http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        access_log         off;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        access_log off;
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }
}
